# ─── Core (required) ───
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require
JWT_SECRET=replace-with-a-long-random-string
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Treasury / wallet (nTZS) ───
# The platform holds ONE master nTZS wallet; members/groups/investors have DB
# balances. The master wallet auto-provisions on first deposit/withdrawal.
NTZS_API_KEY=your-ntzs-api-key
NTZS_BASE_URL=https://www.ntzs.co.tz
# Optional overrides for the master wallet identity:
# NTZS_MASTER_EXTERNAL_ID=master_treasury
# NTZS_MASTER_EMAIL=treasury@washikadau.com
# Withdrawal fee charged ON TOP of the amount (user debited amount + fee, the
# recipient gets the full amount; fee stays in the reserve). Both default to 0.
# WITHDRAWAL_FEE_PERCENT=1.5
# WITHDRAWAL_FEE_FLAT_TZS=0

# ─── Education AI (Anthropic Claude) ───
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional model overrides:
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_MODEL_CONTENT=...
# ANTHROPIC_MODEL_COMPANION_FAST=...
# ANTHROPIC_MODEL_COMPANION_DEEP=...

# ─── Optional / legacy ───
# OPENAI_API_KEY=...                 # older lesson-generation path
# OPENAI_MODEL=...
# SNIPPE_API_KEY=...                 # legacy payment provider
# SNIPPE_WEBHOOK_SECRET=...

# ─── Email notifications (optional) ───
# Donation receipts. Left unset (or left as these placeholders), the donation
# form simply does not offer to email anyone — it never promises a message it
# cannot send. Gmail needs an App Password, not the account password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=WashikaDAU <hello@washikadau.com>

# ─── Neon / Stack auth (optional) ───
# NEXT_PUBLIC_STACK_PROJECT_ID=...
# NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=...
# STACK_SECRET_SERVER_KEY=...
